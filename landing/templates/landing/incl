{% extends "landing/base.html" %}
{% load static %}
{% block title %}Настройки профиля — Нальчик.Афиша{% endblock %}
{% block extra_head %}<meta name="robots" content="noindex">{% endblock %}
{% block content %}
<section class="vb-lk" id="vb-lk" data-section-name="Настройки профиля" aria-label="Настройки профиля" data-vibeblock-unique-section="yes"> <div class="vb-lk__inner"> <nav class="vb-lk-crumbs" aria-label="Навигация по сайту"> <a href="{% url 'index' %}">Главная</a> <span class="vb-lk-crumbs__sep" aria-hidden="true">›</span> <a href="{% url 'cabinet_tickets' %}">Личный кабинет</a> <span class="vb-lk-crumbs__sep" aria-hidden="true">›</span> <span class="vb-lk-crumbs__current">Настройки профиля</span> </nav> <header class="vb-lk-head"> <div class="vb-lk-head__avatar" aria-hidden="true">{% include "landing/_lk_avatar.html" %}</div> <div class="vb-lk-head__text"> <h1 class="vb-lk-head__title">Здравствуйте, {{ user.first_name|default:"друг" }}!</h1> <p class="vb-lk-head__sub">Здесь можно изменить имя, контакты и пароль</p> </div> </header> <div class="vb-lk__layout"> {% include "landing/_cabinet_menu.html" with active="settings" %} <section class="vb-lk-content" aria-labelledby="vb-lk-settings-title"> <header class="vb-lk-content__head"> <h2 class="vb-lk-content__title" id="vb-lk-settings-title">Настройки профиля</h2> </header>
<form class="vb-lk-form" method="post" enctype="multipart/form-data" action="{% url 'cabinet_settings' %}">{% csrf_token %}<input type="hidden" name="form" value="profile">
 <div class="vb-lk-form__avatar"> <div class="vb-lk-form__avatar-circle" aria-hidden="true">{% include "landing/_lk_avatar.html" %}</div> <div class="vb-lk-form__avatar-info"> <div class="vb-lk-form__avatar-title">Фото профиля</div> <div class="vb-lk-form__avatar-hint">PNG, JPG или WebP, до 2 МБ. Лучше квадратное.</div> <div class="vb-lk-form__avatar-actions"> <label class="vb-lk-btn vb-lk-btn--primary vb-lk-file"><span>Загрузить фото</span><input class="vb-lk-file__input" type="file" name="avatar" accept="image/png,image/jpeg,image/webp" id="vb-lk-avatar"></label>{% if profile.avatar %} <button class="vb-lk-btn vb-lk-btn--ghost vb-lk-btn--danger" type="submit" name="remove_avatar" value="1" formnovalidate><span>Удалить</span></button>{% endif %} </div> <div class="vb-lk-form__file" id="vb-lk-fname" hidden></div>{% if errors.avatar %}<span class="vb-lk-form__err">{{ errors.avatar }}</span>{% endif %} </div> </div>
 <div class="vb-lk-form__row"> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Имя</span> <input class="vb-lk-form__input{% if errors.first_name %} is-bad{% endif %}" type="text" name="first_name" value="{{ values.first_name }}" placeholder="Как к вам обращаться" required> {% if errors.first_name %}<span class="vb-lk-form__err">{{ errors.first_name }}</span>{% endif %} </label> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Фамилия</span> <input class="vb-lk-form__input{% if errors.last_name %} is-bad{% endif %}" type="text" name="last_name" value="{{ values.last_name }}" placeholder="Ваша фамилия"> {% if errors.last_name %}<span class="vb-lk-form__err">{{ errors.last_name }}</span>{% endif %} </label> </div>
 <div class="vb-lk-form__row"> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Email</span> <input class="vb-lk-form__input{% if errors.email %} is-bad{% endif %}" type="email" name="email" value="{{ values.email }}" placeholder="you@example.com" required> {% if errors.email %}<span class="vb-lk-form__err">{{ errors.email }}</span>{% endif %} </label> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Телефон</span> <input class="vb-lk-form__input{% if errors.phone %} is-bad{% endif %}" type="tel" name="phone" value="{{ values.phone }}" placeholder="+7 (___) ___-__-__"> {% if errors.phone %}<span class="vb-lk-form__err">{{ errors.phone }}</span>{% endif %} </label> </div>
 <div class="vb-lk-form__row"> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Город</span> <input class="vb-lk-form__input{% if errors.city %} is-bad{% endif %}" type="text" name="city" value="{{ values.city }}" placeholder="Ваш город"> {% if errors.city %}<span class="vb-lk-form__err">{{ errors.city }}</span>{% endif %} </label> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Дата рождения</span> <input class="vb-lk-form__input{% if errors.birthday %} is-bad{% endif %}" type="date" name="birthday" value="{{ values.birthday }}" placeholder=""> {% if errors.birthday %}<span class="vb-lk-form__err">{{ errors.birthday }}</span>{% endif %} </label> </div>
 <label class="vb-lk-form__field"> <span class="vb-lk-form__label">О себе</span> <textarea class="vb-lk-form__textarea{% if errors.bio %} is-bad{% endif %}" name="bio" rows="4" maxlength="500" placeholder="Пару слов о себе — необязательно">{{ values.bio }}</textarea> {% if errors.bio %}<span class="vb-lk-form__err">{{ errors.bio }}</span>{% endif %} </label>
 <div class="vb-lk-form__actions"> <button class="vb-lk-btn vb-lk-btn--primary vb-lk-btn--lg" type="submit"> <span>Сохранить изменения</span> </button> </div>
</form>
<div class="vb-lk-sep"></div>
<header class="vb-lk-content__head vb-lk-content__head--second"> <h2 class="vb-lk-content__title">Смена пароля</h2> </header>
<form class="vb-lk-form" method="post" action="{% url 'cabinet_settings' %}">{% csrf_token %}<input type="hidden" name="form" value="password">
 <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Текущий пароль</span> <input class="vb-lk-form__input{% if errors.old_password %} is-bad{% endif %}" type="password" name="old_password" placeholder="••••••••" autocomplete="current-password"> {% if errors.old_password %}<span class="vb-lk-form__err">{{ errors.old_password }}</span>{% endif %} </label>
 <div class="vb-lk-form__row"> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Новый пароль</span> <input class="vb-lk-form__input{% if errors.new_password %} is-bad{% endif %}" type="password" name="new_password" placeholder="Минимум 8 символов" autocomplete="new-password"> {% if errors.new_password %}<span class="vb-lk-form__err">{{ errors.new_password }}</span>{% endif %} </label> <label class="vb-lk-form__field"> <span class="vb-lk-form__label">Повторите новый</span> <input class="vb-lk-form__input{% if errors.new_password2 %} is-bad{% endif %}" type="password" name="new_password2" placeholder="Ещё раз" autocomplete="new-password"> {% if errors.new_password2 %}<span class="vb-lk-form__err">{{ errors.new_password2 }}</span>{% endif %} </label> </div>
 <div class="vb-lk-form__actions"> <button class="vb-lk-btn vb-lk-btn--primary vb-lk-btn--lg" type="submit"> <span>Сменить пароль</span> </button> </div>
</form> </section> </div> </div> <div class="vb-lk-toast" id="vb-lk-toast" role="status"{% if not saved %} hidden{% endif %}>{{ saved }}</div> </section>
<style>
.vb-lk,.vb-lk * { box-sizing: border-box; }
.vb-lk input,.vb-lk textarea,.vb-lk select { font: inherit; }
.vb-lk { background: linear-gradient(180deg, #f4f8ff 0%, #ffffff 100%); padding: 32px 0 64px; font-family: var(--t-text-font), system-ui, sans-serif; }
.vb-lk__inner { max-width: 1280px; margin: 0 auto; padding: 0 32px; }

.vb-lk-crumbs { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font-size: 13px; color: #6b7280; margin-bottom: 20px; }
.vb-lk-crumbs a { color: #4a90e2; text-decoration: none; transition: color 0.15s; }
.vb-lk-crumbs a:hover { color: #2a5db0; }
.vb-lk-crumbs__sep { color: #cbd2dc; }
.vb-lk-crumbs__current { color: #0f172a; font-weight: 500; }

.vb-lk-head { display: flex; align-items: center; gap: 16px; margin-bottom: 28px; }
.vb-lk-head__avatar {
  width: 56px; height: 56px; border-radius: 50%;
  background: #4a90e2; color: #ffffff;
  display: inline-flex; align-items: center; justify-content: center;
  font-family: var(--t-headline-font), sans-serif;
  font-weight: 700; font-size: 22px; flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(74, 144, 226, 0.3);
}
.vb-lk-head__title {
  font-family: var(--t-headline-font), sans-serif;
  font-size: 28px; font-weight: 700; letter-spacing: -0.02em;
  color: #0f172a; margin: 0 0 4px; line-height: 1.15;
}
.vb-lk-head__sub { font-size: 14px; color: #6b7280; margin: 0; }

.vb-lk__layout { display: grid; grid-template-columns: 260px 1fr; gap: 24px; align-items: start; }

.vb-lk-menu {
  background: #ffffff; border: 1px solid #eef0f3; border-radius: 18px;
  padding: 12px; display: flex; flex-direction: column; gap: 2px;
  position: sticky; top: 140px;
}
.vb-lk-menu__item {
  display: flex; align-items: center; gap: 10px;
  padding: 11px 12px; border-radius: 12px; text-decoration: none;
  color: #0f172a; font-size: 14px; font-weight: 500;
  transition: background 0.15s, color 0.15s;
}
.vb-lk-menu__item:hover { background: #f3f5f8; }
.vb-lk-menu__item--active { background: #eaf2fc; color: #2a5db0; }
.vb-lk-menu__item--active .vb-lk-menu__icon { color: #2a5db0; }
.vb-lk-menu__item--exit { color: #e0394c; margin-top: 6px; border-top: 1px solid #eef0f3; border-radius: 0; padding-top: 14px; }
.vb-lk-menu__item--exit:hover { background: rgba(224, 57, 76, 0.08); }
.vb-lk-menu__icon { color: #6b7280; display: inline-flex; flex-shrink: 0; }
.vb-lk-menu__text { flex: 1; }
.vb-lk-menu__badge {
  background: #4a90e2; color: #ffffff; font-size: 11px; font-weight: 700;
  padding: 2px 7px; border-radius: 999px; min-width: 20px; text-align: center;
}
.vb-lk-menu__item--active .vb-lk-menu__badge { background: #2a5db0; }

.vb-lk-content {
  background: #ffffff; border: 1px solid #eef0f3; border-radius: 18px;
  padding: 26px 28px; min-width: 0;
}
.vb-lk-content__head {
  display: flex; align-items: baseline; justify-content: space-between;
  gap: 12px; flex-wrap: wrap; margin-bottom: 20px;
  padding-bottom: 16px; border-bottom: 1px solid #eef0f3;
}
.vb-lk-content__head--second { margin-top: 8px; }
.vb-lk-content__title {
  font-family: var(--t-headline-font), sans-serif;
  font-size: 22px; font-weight: 700; color: #0f172a; margin: 0;
  letter-spacing: -0.01em;
}

/* === Форма настроек === */
.vb-lk-form { display: flex; flex-direction: column; gap: 16px; }
.vb-lk-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.vb-lk-form__field { display: flex; flex-direction: column; gap: 6px; }
.vb-lk-form__label { font-size: 13px; font-weight: 600; color: #0f172a; }
.vb-lk-form__input,
.vb-lk-form__textarea {
  font-family: var(--t-text-font), system-ui, sans-serif;
  font-size: 15px;
  color: #0f172a;
  background: #ffffff;
  border: 1px solid #e2e6ee;
  border-radius: 12px;
  padding: 12px 14px;
  outline: 0;
  transition: border-color 0.15s, box-shadow 0.15s;
  width: 100%;
}
.vb-lk-form__textarea { resize: vertical; min-height: 100px; line-height: 1.55; }
.vb-lk-form__input:focus,
.vb-lk-form__textarea:focus {
  border-color: #4a90e2;
  box-shadow: 0 0 0 3px rgba(74, 144, 226, 0.15);
}
.vb-lk-form__input::placeholder,
.vb-lk-form__textarea::placeholder { color: #8a93a3; }
.vb-lk-form__actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 4px; }

.vb-lk-form__avatar {
  display: flex; align-items: center; gap: 18px;
  padding: 16px;
  background: #f8fafc;
  border: 1px solid #eef0f3;
  border-radius: 14px;
  flex-wrap: wrap;
}
.vb-lk-form__avatar-circle {
  width: 80px; height: 80px; border-radius: 50%;
  background: #4a90e2; color: #ffffff;
  display: inline-flex; align-items: center; justify-content: center;
  font-family: var(--t-headline-font), sans-serif;
  font-weight: 700; font-size: 32px; flex-shrink: 0;
  box-shadow: 0 4px 14px rgba(74, 144, 226, 0.3);
}
.vb-lk-form__avatar-info { flex: 1; min-width: 200px; }
.vb-lk-form__avatar-title { font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }
.vb-lk-form__avatar-hint { font-size: 12px; color: #8a93a3; margin-bottom: 10px; line-height: 1.5; }
.vb-lk-form__avatar-actions { display: flex; gap: 8px; flex-wrap: wrap; }

.vb-lk-sep {
  height: 1px;
  background: #eef0f3;
  margin: 32px 0 24px;
}

.vb-lk-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  padding: 10px 18px; border-radius: 10px; border: 1px solid transparent;
  font-family: var(--t-text-font), system-ui, sans-serif;
  font-size: 13px; font-weight: 600; text-decoration: none; cursor: pointer;
  transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s;
}
.vb-lk-btn--primary { background: #4a90e2; color: #ffffff !important; }
.vb-lk-btn--primary:hover { background: #3a7bc8; transform: translateY(-1px); }
.vb-lk-btn--ghost { background: #ffffff; color: #2a5db0 !important; border-color: #c8d6ee; }
.vb-lk-btn--ghost:hover { background: #eaf2fc; border-color: #4a90e2; }
.vb-lk-btn--danger { color: #e0394c !important; border-color: #f4c8cd; }
.vb-lk-btn--danger:hover { background: rgba(224, 57, 76, 0.08); border-color: #e0394c; }
.vb-lk-btn--lg { padding: 14px 28px; font-size: 15px; }

@media (max-width: 960px) {
  .vb-lk__inner { padding: 0 18px; }
  .vb-lk__layout { grid-template-columns: 1fr; }
  .vb-lk-menu { position: static; flex-direction: row; overflow-x: auto; padding: 8px; gap: 4px; }
  .vb-lk-menu__item { flex: 0 0 auto; }
  .vb-lk-menu__text { display: none; }
  .vb-lk-menu__badge { display: none; }
  .vb-lk-menu__item--exit { border: 0; margin: 0; padding: 11px 12px; border-radius: 12px; }
  .vb-lk-head__title { font-size: 22px; }
  .vb-lk-form__row { grid-template-columns: 1fr; }
}
@media (max-width: 640px) {
  .vb-lk-head { gap: 12px; }
  .vb-lk-head__avatar { width: 44px; height: 44px; font-size: 18px; }
  .vb-lk-head__title { font-size: 20px; }
  .vb-lk-content { padding: 20px; }
  .vb-lk-form__avatar { flex-direction: column; align-items: flex-start; text-align: left; }
}
.vb-lk-toast { position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%); z-index: 90; padding: 13px 22px; border-radius: 99px; background: #0f172a; color: #fff; font-size: 15px; font-weight: 600; box-shadow: 0 10px 30px rgba(15, 23, 42, 0.25); }
.vb-lk-toast[hidden] { display: none; }
.vb-lk-form__err { font-size: 12px; color: #c0283a; line-height: 1.4; }
.vb-lk-form__input.is-bad, .vb-lk-form__textarea.is-bad { border-color: #e0394c; }
.vb-lk-file { position: relative; cursor: pointer; }
.vb-lk-file__input { position: absolute; inset: 0; opacity: 0; width: 100%; cursor: pointer; font-size: 0; }
.vb-lk-form__file { font-size: 12px; color: #475569; margin-top: 8px; }
.vb-lk-form__file[hidden] { display: none; }
</style>
<script>
(function() {
  var toast = document.getElementById('vb-lk-toast');
  if (toast && !toast.hidden) setTimeout(function() { toast.hidden = true; }, 3000);
  var file = document.getElementById('vb-lk-avatar'), name = document.getElementById('vb-lk-fname');
  if (file && name) file.addEventListener('change', function() {
    if (file.files && file.files[0]) { name.textContent = 'Выбран файл: ' + file.files[0].name + '. Нажмите «Сохранить изменения».'; name.hidden = false; }
  });
})();
</script>
{% endblock %}
